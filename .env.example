# ==============================================================================
# AgentPulse HQ - Environment Configuration Template
# Copy this file to .env before deploying: cp .env.example .env
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. APPLICATION & SECURITY
# ------------------------------------------------------------------------------
DJANGO_DEBUG=False
DJANGO_SECRET_KEY=change_this_to_a_cryptographically_secure_random_string_in_production
ALLOWED_HOSTS=localhost,127.0.0.1,your-vps-ip,yourdomain.com
CORS_ALLOW_ALL_ORIGINS=False
CORS_ALLOWED_ORIGINS=https://yourdomain.com,http://localhost:3000

# ------------------------------------------------------------------------------
# 2. POSTGRESQL / POSTGIS DATABASE
# ------------------------------------------------------------------------------
POSTGRES_DB=agentpulse_db
POSTGRES_USER=agentpulse_user
POSTGRES_PASSWORD=your_secure_database_password_here
POSTGRES_HOST=db
POSTGRES_PORT=5432
# Combined Database URL format (used automatically by dj-database-url)
DATABASE_URL=postgresql://agentpulse_user:your_secure_database_password_here@db:5432/agentpulse_db

# ------------------------------------------------------------------------------
# 3. REDIS & CHANNELS WEBSOCKETS
# ------------------------------------------------------------------------------
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_URL=redis://redis:6379/0

# ------------------------------------------------------------------------------
# 4. CLOUD MEDIA & ASSET STORAGE (Optional: AWS S3 / Cloudinary)
# ------------------------------------------------------------------------------
USE_S3_STORAGE=False
AWS_ACCESS_KEY_ID=your_aws_access_key
AWS_SECRET_ACCESS_KEY=your_aws_secret_key
AWS_STORAGE_BUCKET_NAME=agentpulse-media-bucket
AWS_S3_REGION_NAME=us-east-1

# ------------------------------------------------------------------------------
# 5. FRONTEND & PWA PUBLIC VARIABLES
# ------------------------------------------------------------------------------
PORT=80
NEXT_PUBLIC_APP_NAME="AgentPulse HQ"
# In local Docker behind Nginx:
NEXT_PUBLIC_API_URL=http://localhost/api
NEXT_PUBLIC_WS_URL=ws://localhost/ws/location/

# For Production with SSL (HTTPS):
# NEXT_PUBLIC_API_URL=https://yourdomain.com/api
# NEXT_PUBLIC_WS_URL=wss://yourdomain.com/ws/location/

# ------------------------------------------------------------------------------
# 6. MAP & LOCATION SERVICES (Optional: Mapbox / OSM)
# ------------------------------------------------------------------------------
# AgentPulse HQ defaults to 100% free, watermark-free OpenStreetMap tiles.
# If Mapbox tiles or satellite imagery are desired:
MAPBOX_ACCESS_TOKEN=your_mapbox_public_token_optional
